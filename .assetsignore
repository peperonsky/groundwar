# Repo files that aren't part of the site, kept off the Cloudflare Worker.
# (places/manifest.json is the place-page build's own bookkeeping.)
# (_headers and _redirects are read by Cloudflare, not served.)
# .git must be listed: Workers Builds deploys from a fresh clone, and without
# this line the whole git history went up as public files, until its pack
# file passed the 25 MiB per-file limit and every deploy failed.
.git
.assetsignore
.gitattributes
.gitignore
.github
.wrangler
node_modules
scripts
wrangler.jsonc
README.md
serve.js
worker.js
places/manifest.json
