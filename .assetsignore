# Repo files that aren't part of the site, kept off the Cloudflare Worker.
# (places/manifest.json is the place-page build's own bookkeeping.)
# (.git is never uploaded; _headers is read by Cloudflare, not served.)
.assetsignore
.gitattributes
.gitignore
.github
.wrangler
node_modules
scripts
wrangler.jsonc
README.md
serve.js
worker.js
CNAME
places/manifest.json
